# DDoS Guard - Ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin: cp .env.example .env

# Proxy'nin dinleyeceği port
PORT=8080

# Korumak istediğiniz gerçek backend adresi
TARGET_URL=http://localhost:3000

# SADECE nginx/cloud load balancer gibi güvenilen bir proxy arkasındaysanız true yapın
TRUST_PROXY=false

# --- Rate limiting ---
RATE_WINDOW_MS=10000
RATE_MAX_REQUESTS=100
RATE_BAN_MS=60000

# --- Bağlantı / burst tespiti ---
MAX_CONCURRENT_PER_IP=50
BURST_THRESHOLD=30
BURST_WINDOW_MS=1000

# --- İtibar sistemi ---
VIOLATIONS_BEFORE_LONG_BAN=5
LONG_BAN_MS=1800000
WHITELIST_IPS=127.0.0.1,::1
BLACKLIST_IPS=

# --- Layer 7 JS Challenge ---
CHALLENGE_ENABLED=true
SUSPICION_THRESHOLD=3
CHALLENGE_COOKIE_TTL_MS=900000
# ÖNEMLİ: production'da bunu mutlaka değiştirin (örn: openssl rand -hex 32)
CHALLENGE_SECRET=change-this-secret-in-production

# --- Loglama ---
LOG_LEVEL=info
